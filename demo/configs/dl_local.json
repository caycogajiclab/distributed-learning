            "h_bias": true,
            "sigma_rec": 0
        },
        "rnn_specs": {
            "out_bias": false,
            "sigma_in": 0.0,
            "init_method": "uniform",
            "nonlin": "linear",
            "private_gradients": true
        },
        "cereb_specs": {
            "sizes": [1024, 1024],
            "bias": true,
            "init_method": "xavier_normal",
            "init_gain": 0.1,
            "h_nlin": "relu",
            "out_nlin": "linear",
            "private_gradients": true
        },
        "inter_specs": {
            "weight_distro": ["uniform"],
            "bias_distro": ["uniform"],
            "autoencoder": false,
            "gain": 1
        },
        "nonlinearity_specs": {
            "module": "TwoJointsArm"
        }
    },
    "train_params": {
        "epochs": 2000,
        "cx_lr": null,
        "cx_lr_start": null,
        "cx_error": "cx-only",
        "correction_fb": false,
        "cb_lr": 1e-4,
        "fb_lr": null,
        "fb_lr_start": null,
        "l1": 0.0,
        "l2": 0.0,
        "activity_penalty": 0.0,
        "reg_drop": null,
        "local_lr": 5e-3,
        "local_rule_settings": [1, 0, false],
        "cb_scheduler": 5000,
        "early_stop": false,
        "es_params": [500, 1e-9]
    },
    "settings": {
        "datatype": "cart",
        "opt": null,
        "outsave_step": 0,
        "print_steps": 100,
        "save_w_steps": 50,
        "record_gradients": false,
        "save_cortex": false,
        "verbose": false,
        "debug_step": false
    },
    "model_state": {
        "cereb_feedback": true,
        "cereb_readout": true,
        "modules_plasticity": {
            "cortex_hw": false,
            "cortex_hb": false,
            "cortex_in": false,
            "cortex_out": false,
            "cereb_to_cortex": false,
            "cereb": true
        },
        "local_plasticity": true,
        "plant": true
    }
