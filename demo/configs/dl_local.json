{
    "_comment": "DEMO config for scripts/train_model.py (DL-local). Derived from scripts/configs/DL-local/template_config.json, reduced for a single fast run: one seed, one local_lr (5e-3, the canonical value from the sweep), gain=1, 2000 epochs. The notebook injects 'work_dir', 'cx_pretrain_path' and 'cb_pretrain_path' at runtime. NOT a paper config.",
    "name": "DL-local",
    "seed": 24,
    "iterations": 1,
    "rnn_hidden_size": 256,
    "model_class": "CerebelloCorticalNet",
    "dataset_params": {
        "tasks": 8,
        "small_ring": false,
        "target": "moving",
        "interpolation": "bell",
        "timesteps": 130,
        "hold_cue_time": 30,
        "t_in_duration": 30,
        "small_ring_rot": true,
        "rings_size": [0.1, 0.05],
        "joints_length": [0.22, 0.27],
        "input_type": "autoenc",
        "input_mode": "full-go"
    },
    "perturbation_params": {
