{
    "home": "",
    "work_dir": "",
    "cx_pretrain_path": "",
    "cb_pretrain_path": "",
    "name": "a_enc.pos",
    "seed": 12,
    "iterations": 5,
    "use_cuda": false,
    "rnn_hidden_size": 256,
    "model_class": "CerebelloCorticalNet",
    "dataset_params": {
        "tasks": 8,
        "small_ring": false,
        "target": "moving",
        "interpolation": "bell",
        "timesteps": 130,
        "hold_cue_time": 30,
        "t_in_duration": 30,
        "small_ring_rot": true,
        "rings_size": [0.1, 0.05],
        "joints_length": [0.22, 0.27],
        "input_type": "autoenc",
        "input_mode": "full-go"
    },
    "perturbation_params": null,
    "net_params": {
        "ct": false,
    
        "hidden_layer_specs": {
            "nonlinearity": "tanh",
            "init_method": "uniform",
            "dt": 10,
            "tau": 100,
            "in_bias": true,
            "h_bias": true,
            "sigma_rec": 0
        },
    
        "rnn_specs": {
            "out_bias": false,
            "sigma_in": 0.0,
            "init_method": "uniform",
            "nonlin": "linear",
            "private_gradients": false
        },
    
        "cereb_specs": {
            "sizes": [
                1024,
                1024
            ],
            "bias": true,
            "init_method": "xavier_normal",
            "init_gain": 0.1,
            "h_nlin": "relu",
            "out_nlin": "linear",
            "private_gradients": false
        },
    
        "inter_specs": {
            "weight_distro": ["uniform"],
            "bias_distro": ["uniform"],
            "autoencoder": false,
            "gain": 1
        },
    
        "nonlinearity_specs": {
            "module": "TwoJointsArm"
        }
    },
    "pretrain_params": {
        "epochs": 50000,
        "correction_fb": true,
        "lr": 1e-4,
        "fb_lr": null,
        "fb_lr_start": 1000,
        "l1": 0.0,
        "l2": 1e-4,
        "activity_penalty": 0.0,
