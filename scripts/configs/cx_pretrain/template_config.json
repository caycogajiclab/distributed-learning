        "verbose": true,
        "debug": false,
        "tensorboard_params": {}
    },
    "model_state": {
        "cereb_feedback": false,
        "cereb_readout": false,
        "modules_plasticity": {
            "cortex_hw": true,
            "cortex_hb": true,
            "cortex_in": true,
            "cortex_out": false,
            "cereb_to_cortex": false,
            "cereb": false
        },
        "local_plasticity": false,
        "plant": true
    }
